# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库。
# MongoDB Atlas 连接串：在 Atlas「Connect -> Drivers」页面复制，把 <db_password> 换成你的数据库用户密码。
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# 数据库名（可自定义）
DB_NAME=bank_counter

# 用于签发登录令牌的密钥，请改成一串随机字符
SECRET_KEY=change-me-to-a-long-random-string
